<mxfile><diagram name="d"><mxGraphModel adaptiveColors="none" background="#FFFFFF" grid="0" page="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;Who carries the corporate tax&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=22;fontStyle=1;fontColor=#2B2B2B;" vertex="1" parent="1"><mxGeometry x="225" y="8" width="350" height="36" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Corporate tax&lt;/b&gt;&lt;br&gt;&lt;small&gt;counted in the paper as a third each&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;fontSize=14;fontColor=#17324A;fillColor=#E6F2FC;strokeColor=#3A78AC;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="275" y="70" width="250" height="56" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;One third on consumers&lt;/b&gt;&lt;br&gt;&lt;small&gt;higher prices&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;fontSize=14;fontColor=#4A3606;fillColor=#FFF7DC;strokeColor=#C4972F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="230" height="56" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;One third on workers&lt;/b&gt;&lt;br&gt;&lt;small&gt;lower pay&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;fontSize=14;fontColor=#4A3606;fillColor=#FFF7DC;strokeColor=#C4972F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="285" y="190" width