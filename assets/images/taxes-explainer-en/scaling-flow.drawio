<mxfile><diagram name="d"><mxGraphModel adaptiveColors="none" background="#FFFFFF" grid="0" page="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;From survey to household estimate&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=22;fontStyle=1;fontColor=#2B2B2B;" vertex="1" parent="1"><mxGeometry x="130" y="8" width="420" height="36" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Household survey&lt;/b&gt;&lt;br&gt;&lt;small&gt;VAT found: $20.5bn&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;fontSize=14;fontColor=#17324A;fillColor=#E6F2FC;strokeColor=#3A78AC;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="270" height="56" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Official tax data&lt;/b&gt;&lt;br&gt;&lt;small&gt;VAT collected: $27.7bn&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;fontSize=14;fontColor=#2B2B2B;fillColor=#F2F2F2;strokeColor=#6B6B6B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="370" y="70" width="270" height="56" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Scaling factor: about 1.35&lt;/b&gt;&lt;br&gt;&lt;small&gt;27.7 divided by 20.5&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;fontSize=14;fontColor=#4A3606;fillColor=#FFF7DC;strokeColor=#C4972F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="205" y="1